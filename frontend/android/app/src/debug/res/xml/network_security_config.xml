<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY.

    This file lives under src/debug/, so it is merged into debug builds and is
    absent from release ones. A release APK keeps Android's default policy,
    which refuses cleartext entirely.

    Android has blocked plain http:// by default since API 28, and the failure
    is silent at the socket layer - the app just reports that it cannot reach
    the server, which looks exactly like a Wi-Fi or firewall problem. The local
    development backend is plain http, so debug builds need this exemption to
    talk to it at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
