# ============================================================
# FLUTTER / DART (frontend/)
# ============================================================

# Build outputs
# Unanchored so it also catches frontend/android/build/ and
# frontend/android/app/build/, which the old frontend/build/ rule missed.
build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
# pubspec.lock is intentionally NOT ignored. That is right for a package, wrong
# for an application: without it this machine and CI can resolve different
# dependency versions and build subtly different apps.

# Android build artifacts
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/debug/
frontend/android/app/release/
frontend/android/key.properties

# iOS (not used in this project but just in case)
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec

# ============================================================
# PYTHON / FLASK (backend/)
# ============================================================

# Virtual environment - NEVER commit this
# Unanchored: the old backend/venv/ rule did not match the venv/ at the
# repository root, so 1356 files of site-packages were tracked.
venv/
.venv/
env/

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables file (keep secrets out of GitHub)
backend/.env
.env

# Flask instance folder
backend/instance/

# SQLite database files (runtime data, not source code)
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# ============================================================
# VS CODE
# ============================================================

.vscode/
*.code-workspace

# ============================================================
# WINDOWS
# ============================================================

Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# GENERAL
# ============================================================

# OS files
.DS_Store

# Log files
*.log

# Temporary files
*.tmp
*.temp
