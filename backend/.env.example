# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

DATABASE_URL=sqlite:///finance_tracker.db
JWT_SECRET_KEY=generate-a-random-secret-e.g.-python -c "import secrets; print(secrets.token_hex(32))"

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_USER=your-app-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=your-twilio-phone-number
